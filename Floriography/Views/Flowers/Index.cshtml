@model List<Floriography.Models.FlowerModel>

@{
    ViewBag.Title = "Floriography Dictionary";
    // Grouping logic stays here, but the <img> tag is removed from this block
    var alphabetGroups = Model.GroupBy(f => f.Letter).OrderBy(g => g.Key).ToList();
}

<style>
    body {
        /* Wrapped in quotes to handle the space in "Project Images" */
        background-image: url("/Project Images/flo6.jpg");
        background-size: cover;
        background-attachment: fixed;
        font-family: 'Georgia', serif;
    }

    .dictionary-container {
        max-width: 900px;
        margin: 40px auto;
        padding: 20px;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border-radius: 15px;
    }

    .custom-banner {
        display: inline-block;
        margin-bottom: 40px;
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        color: #4a5d4e;
        padding: 10px 50px;
        font-size: 20px;
        font-weight: 600;
        border-radius: 50px;
        text-decoration: none;
        border: 2px solid rgba(74, 93, 78, 0.3);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        transition: all 0.4s ease;
    }

        .custom-banner:hover {
            background: linear-gradient(to right, rgb(167, 188, 138), rgb(248, 147, 114));
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
            color: #2f3e34;
        }



    h1 {
        color: #4a5d4e;
        margin-bottom: 30px;
        font-variant: small-caps;
        border-bottom: 2px solid #eef2f0;
        display: inline-block;
        padding-bottom: 10px;
    }

    #alphabet-buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-bottom: 40px;
    }

    .flower-btn {
        width: 55px;
        height: 55px;
        border: 1px solid #d1d9d3;
        background: white;
        color: #4a5d4e;
        font-size: 1.2rem;
        font-weight: bold;
        border-radius: 50%;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
    }

        .flower-btn:hover {
            background-color: #4a5d4e;
            color: white;
            transform: scale(1.15);
            box-shadow: 0 5px 15px rgba(74, 93, 78, 0.3);
        }

    #display-card {
        margin-top: 20px;
        padding: 30px;
        border: 2px solid #f0f0f0;
        border-radius: 20px;
        animation: fadeIn 0.6s ease-out;
        background: #fafcfb;
    }

    #flowerImg {
        width: 300px;
        height: 300px;
        object-fit: cover;
        border-radius: 50%;
        border: 10px solid white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    #flowerName {
        color: #2c3e50;
        font-size: 2.5rem;
        margin-top: 10px;
    }

    #flowerMeaning {
        font-size: 1.3rem;
        color: #7f8c8d;
        font-style: italic;
        margin-bottom: 20px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>

<div class="dictionary-container text-center">
    <h1>The Language of Flowers</h1>

    <a href="/Flowers/EnterName" class="custom-banner">
        Discover Flower's Messages of Your Name! 
    </a>

    <div id="alphabet-buttons">
        @foreach (var group in alphabetGroups)
        {
            var jsonFlowers = Newtonsoft.Json.JsonConvert.SerializeObject(group.ToList());
            <button class="flower-btn" onclick="showRandomFlower(@jsonFlowers)">
                @group.Key
            </button>
        }
    </div>

    <div id="display-card" style="display:none;">
        @* The image src starts empty and is filled by JavaScript *@
        <img id="flowerImg" src="" alt="Flower image" />
        <h2 id="flowerName"></h2>
        <p id="flowerMeaning"></p>
        <p class="text-muted"><small>Click the same letter again to see a different flower!</small></p>
        <button class="btn btn-outline-secondary btn-sm mt-3" onclick="document.getElementById('display-card').style.display='none'">Close</button>
    </div>
</div>

<script>
    function showRandomFlower(flowerOptions) {
        const card = document.getElementById('display-card');
        const selected = flowerOptions[Math.floor(Math.random() * flowerOptions.length)];

        document.getElementById('flowerName').innerText = selected.Name;
        document.getElementById('flowerMeaning').innerText = '“' + selected.Meaning + '”';

        // This line is key: it removes the '~' so the browser can find your folder
        let cleanPath = selected.ImageUrl.replace('~', '');
        document.getElementById('flowerImg').src = cleanPath;

        card.style.display = 'block';
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
</script>
