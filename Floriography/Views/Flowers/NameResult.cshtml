@model List<Floriography.Models.FlowerModel>

@{
    ViewBag.Title = "Name Result";
}

<style>
    body {
        /* Wrapped in quotes to handle the space in "Project Images" */
        background-image: url("/Project Images/flo6.jpg");
        background-size: cover;
        background-attachment: fixed;
        font-family: 'Georgia', serif;
    }
    .flower-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 40px;
        margin-top: 40px;
    }

    .flower-card {
        width: 280px;
        text-align: center;
        padding: 20px;
        background-color: #ffffff;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        transition: transform 0.3s ease;
    }

        .flower-card:hover {
            transform: translateY(-8px);
        }

        .flower-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 12px;
            margin: 15px 0;
        }

        .flower-card h3 {
            margin-bottom: 10px;
            font-size: 1.6rem;
            color: #2c3e50;
        }

        .flower-card p {
            font-size: 1.1rem;
            color: #555;
        }

    .page-title {
        text-align: center;
        margin-top: 30px;
        font-size: 2.5rem;
        color: #2c3e50;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 40px;
        font-size: 1.1rem;
    }
    #t1{
        color:black;
        text-decoration:none;
        font-weight:bold;

    }
    #t1:hover {
        background: linear-gradient(to right, rgb(167, 188, 138), rgb(248, 147, 114));
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
        color: #2f3e34;
    }
    

</style>

<h2 class="page-title">
    Floral Message for  @ViewBag.UserName
</h2>

<div class="flower-row">
    @foreach (var flower in Model)
    {
        <div class="flower-card">
            <h3>@flower.Name</h3>
            <img src="@Url.Content(flower.ImageUrl)" alt="@flower.Name" />
            <p><strong>Meaning:</strong> @flower.Meaning</p>
        </div>
    }
</div>

<a class="back-link" href="/Flowers/EnterName" id="t1">
    Try Another Name
</a>
